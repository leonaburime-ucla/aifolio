{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm --workspaces=false install --package-lock=false",
  "buildCommand": "npm --workspaces=false run build",
  "outputDirectory": ".next",
  "devCommand": "npm --workspaces=false run dev -- --port $PORT"
}

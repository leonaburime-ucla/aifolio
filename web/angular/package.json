{
  "name": "@aifolio/angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "vercel:install": "npm install && rm -rf ../packages/frontend-core/node_modules ../packages/contracts/node_modules && ln -s ../../angular/node_modules ../packages/frontend-core/node_modules && ln -s ../../angular/node_modules ../packages/contracts/node_modules",
    "guard:features": "node scripts/verify-feature-boundaries.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@aifolio/contracts": "file:../packages/contracts",
    "@aifolio/frontend-core": "file:../packages/frontend-core",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "echarts": "^6.1.0",
    "papaparse": "^5.5.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}

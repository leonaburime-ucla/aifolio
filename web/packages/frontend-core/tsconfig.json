{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@aifolio/contracts/*": ["../contracts/src/*"],
      "@aifolio/contracts/entities/chat/api": ["../contracts/src/entities/chat/api.types.ts"],
      "@aifolio/contracts": ["../contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
